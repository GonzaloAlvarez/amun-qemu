#!/usr/bin/env bash
# amun-qemu — Layer 4 verify. Pure shell; no python/ansible on the target.
# Per /Users/galvarez/dev/homelab/CLAUDE.md §14.1 — every amun-* package
# must ship a ./verify script.
#
#   ./verify                            # local host
#   ./verify --host HOST [--user USER]  # over SSH
#
# The KVM boot probe is CONDITIONAL: hosts without /dev/kvm (tart VMs,
# Pis, containers) get a SKIP line, never a FAIL.
set -u

HOST=""
SSH_USER=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    --user) SSH_USER="$2"; shift 2 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ -n "$HOST" ]; then
  RUNNER() { ssh -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=accept-new "${SSH_USER:+$SSH_USER@}$HOST" "$@"; }
else
  RUNNER() { bash -c "$*"; }
fi

PASS=0
FAIL=0
check() {
  local label="$1"; shift
  if RUNNER "$*" >/dev/null 2>&1; then
    printf '  \033[32mPASS\033[0m  %s\n' "$label"; PASS=$((PASS + 1))
  else
    printf '  \033[31mFAIL\033[0m  %s\n' "$label"; FAIL=$((FAIL + 1))
  fi
}

NATIVE_ARCH="$(RUNNER "uname -m" 2>/dev/null)"
case "$NATIVE_ARCH" in
  arm64|aarch64) QARCH=aarch64 ;;
  x86_64|amd64)  QARCH=x86_64 ;;
  *) echo "FAIL: unsupported/unreadable arch '$NATIVE_ARCH'"; exit 1 ;;
esac

echo "== amun-qemu verify =="
echo "Target: ${HOST:-localhost}  Arch: $QARCH"
echo
echo "Binaries:"
check "qemu-system-$QARCH"             "command -v qemu-system-$QARCH"
check "qemu-img"                       "command -v qemu-img"
check "iso tool (genisoimage|mkisofs)" "command -v genisoimage || command -v mkisofs"
check "socat"                          "command -v socat"

echo
echo "UEFI firmware (any per-distro candidate path):"
check "firmware blob present" "ls /usr/share/OVMF/OVMF_CODE*.fd /usr/share/AAVMF/AAVMF_CODE*.fd /usr/share/edk2/x64/OVMF_CODE*.fd /usr/share/edk2-ovmf/x64/OVMF_CODE*.fd /usr/share/edk2/aarch64/QEMU_EFI*.fd /usr/share/edk2-armvirt/aarch64/QEMU_EFI*.fd 2>/dev/null | grep -q ."

echo
echo "KVM (conditional — hardware-dependent, never a FAIL when absent):"
if RUNNER "test -c /dev/kvm" >/dev/null 2>&1; then
  # rc 124 = qemu ran KVM-accelerated until timeout killed it; a qemu that
  # cannot open /dev/kvm exits immediately nonzero instead.
  if [ "$QARCH" = "aarch64" ]; then
    # aarch64 has no default machine type; -M virt -cpu host is mandatory.
    check "KVM-accelerated boot (rc=124 == ran until timeout)" \
      'timeout 10 qemu-system-aarch64 -M virt -cpu host -enable-kvm -display none -serial none -monitor none -m 128 >/dev/null 2>&1; test $? -eq 124'
  else
    check "KVM-accelerated boot (rc=124 == ran until timeout)" \
      'timeout 10 qemu-system-x86_64 -cpu host -enable-kvm -display none -serial none -monitor none -m 128 >/dev/null 2>&1; test $? -eq 124'
  fi
else
  printf '  \033[33mSKIP\033[0m  /dev/kvm not present on this host (tart VM / Pi / container) — KVM boot check skipped\n'
fi

echo
echo "== Summary =="
echo "  Pass: $PASS"
echo "  Fail: $FAIL"

if [ "$FAIL" -ne 0 ]; then exit 1; fi
exit 0
