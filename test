#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AMUN_TMPDIR=$(mktemp -d)

trap 'rm -rf "$AMUN_TMPDIR"' EXIT SIGINT SIGTERM

git clone https://github.com/GonzaloAlvarez/amun.git "$AMUN_TMPDIR/amun"
cp -r "$SCRIPT_DIR" "$AMUN_TMPDIR/amun-qemu"

# -p qemu stays LAST: amun/test's -p greedily consumes following non-dash args.
if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
    # Classic local path: ./test <platform> [extra flags] (tart/QEMU; TCG only)
    PLATFORM="$1"; shift
    "$AMUN_TMPDIR/amun/test" "$PLATFORM" "$@" -p qemu
else
    # Default: billable cloud KVM run — Debian 13 amd64 devbox with real
    # /dev/kvm (nested virt doesn't work under macOS hvf). Extra flags
    # (e.g. --profile <aws-profile>) pass straight through.
    "$AMUN_TMPDIR/amun/test" debian --cloud --kvm "$@" -p qemu
fi
